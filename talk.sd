 │          ┌───<u>▼</u>───┐ ┌───<u>▼</u>───┐       ┌───<u>▼</u>───┐        ┌───<u>▼</u>───┐    │
 │          │  job  │ │  job  │       │  job  │        │  job  │    │   <i>one</i> <i>job</i> <i>per</i> <i>node</i>
 │          └───<em>┬</em>───┘ └───<em>┬</em>───┘       └───<em>┬</em>───┘        └───<em>┬</em>───┘    │   <i>pfcon</i> <i>sees</i> <i>no</i> <i>DAG</i>
 │              <em>┆</em>         <em>┆</em>               <em>┆</em>                <em>┆</em>        │
 ├─ <em>OpenShift</em> ──<em>┼</em>─────────<em>┼</em>───────────────<em>┼</em>────────────────<em>┼</em>────────┤
 │          <em>┌───</em><u><em>▼</em></u><em>───┐</em> <em>┌───</em><u><em>▼</em></u><em>───┐</em>       <em>┌───</em><u><em>▼</em></u><em>───┐</em>        <em>┌───</em><u><em>▼</em></u><em>───┐</em>    │
 │          <em>│</em>  <em>pod</em>  <em>│</em> <em>│</em>  <em>pod</em>  <em>│</em>       <em>│</em>  <em>pod</em>  <em>│</em>        <em>│</em>  <em>pod</em>  <em>│</em>    │   <i>physical:</i> <i>one</i> <i>pod</i> <i>per</i> <i>job</i>
 │          <em>└───────┘</em> <em>└───────┘</em>       <em>└───────┘</em>        <em>└───────┘</em>    │   <i>the</i> <i>cluster</i> <i>sees</i> <i>only</i> <i>pods</i>
 └──────────────────────────────────────────────────────────────────┘
</pre>}
    }
    .takeaway{CUBE HOLDS THE DAG. THE CLUSTER SEES ONLY PODS.}
  }
}

.slide{
  .id{architecture-end}
  .title{Who Owns What}
  .body{
    .h1{Who Owns What}
    .term{
.typewriter{$> chris --layers}
      .o{<pre class="fig">
 ┌──────────────────────────────────────────┐
 │                   <b>CUBE</b>                   │   <i><b>meaning</b>: which app, which directory,</i>
 └─────┬────────────────────────────────────┤   <i>which parameters</i>
       │               <b>pfcon</b>                │   <i><b>mapping</b>: that run, on this backend</i>
       └─────┬──────────────────────────────┤
             │           <b>cluster</b>            │   <i><b>execution</b>: pods, storage, policy</i>
             └──────────────────────────────┘
</pre>}
      .o{CUBE owns .bf{meaning}. pfcon maps it. The cluster runs it.}
      .o{One CUBE, several .bf{compute} environments.}
      .o{The lock-in test: does it run .bf{without} Kubernetes?}
    }
    .takeaway{REPLACE MECHANISMS FREELY. DON'T REPLACE THE MEANING OF THE WORKFLOW.}
  }
}

