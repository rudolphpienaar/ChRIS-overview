      /                      <b>CUBE</b> <b>API</b>                       / │
     /                                                     /  │
    ┌─────────────────────────────────────────────────────┐   ┘
    │                        <b>CUBE</b>                         │  /
    │              <i>users</i>  <i>·</i>  <i>files</i>  <i>·</i>  <i>feeds</i>              │ /
    │          <i>apps</i>  <i>·</i>  <i>pipelines</i>  <i>·</i>  <i>provenance</i>          │/
    └─────<em>┬</em>─────────────<em>┬</em>─────────────<em>┬</em>─────────────<em>┬</em>─────┘
    <em>┌─────┴─────┐</em> <em>┌─────┴─────┐</em> <em>┌─────┴─────┐</em> <em>┌─────┴─────┐</em>
    <em>│</em>   <em>pfcon</em>   <em>│</em> <em>│</em>   <em>pfcon</em>   <em>│</em> <em>│</em>   <em>pfcon</em>   <em>│</em> <em>│</em>   <em>pfcon</em>   <em>│</em>
    <em>├───────────┤</em> <em>├───────────┤</em> <em>├───────────┤</em> <em>├───────────┤</em>                           <b>pfcon</b>: one per compute environment,
    <em>│</em> <em>OpenShift</em> <em>│</em> <em>│</em>    <em>k8s</em>    <em>│</em> <em>│</em>    <em>HPC</em>    <em>│</em> <em>│</em>    <em>VM</em>     <em>│</em>                           the same contract on each.
    <em>└───────────┘</em> <em>└───────────┘</em> <em>└───────────┘</em> <em>└───────────┘</em>
 
</pre>}
      .o{<pre class="fig step">
     ┌─────────┐     ┌──────────┐ ┌─────────┐ ┌─────────┐
     │ <b>browser</b> │     │ <b>terminal</b> │ │ <b>browser</b> │ │ <b>program</b> │      <i>entry</i> <i>points</i>
