 │                   <em>┌────</em><u><em>▼</em></u><em>────┐</em>                                    │
 │                   <em>│</em>  <em>embed</em>  <em>│</em>                                    │
 │                   <em>└─────────┘</em>                                    │
 │                                                                  │
