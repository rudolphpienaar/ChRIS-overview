#!/usr/bin/env bash
#
# chell-live: serve one chell in a browser terminal for the "A Live chell" slide.
#
# The slide embeds http://localhost:7681 in a frame. ttyd answers there with
# xterm.js and bridges it to the command given here, run under a
# pseudo-terminal on this machine. The login stays with chell on this machine;
# nothing about it is in the deck.
#
# Usage:
#   scripts/chell-live                      # runs: chell --remote
#   scripts/chell-live chell --remote --attach ws://host:port --token ...
#   scripts/chell-live chell --remote --door https://door.example
#
# ttyd is bound to loopback, so only a browser on this machine reaches it, and
# it checks the origin, so only its own page may open the terminal. Do not
# change the bind address: on a LAN address it hands this shell to the network.
#
# Requires: ttyd (Arch: pacman -S ttyd), chell.

set -euo pipefail

PORT="${CHELL_LIVE_PORT:-7681}"

if ! command -v ttyd >/dev/null 2>&1; then
    echo "chell-live: ttyd is not installed (Arch: sudo pacman -S ttyd)" >&2
    exit 1
fi

if [ "$#" -eq 0 ]; then
    set -- chell --remote
fi

exec ttyd \
    --port "$PORT" \
    --interface 127.0.0.1 \
    --writable \
    --check-origin \
    --client-option disableLeaveAlert=true \
    --client-option fontSize=32 \
    --client-option 'theme={"background":"#141414","foreground":"#d4d4d4","cursor":"#4ec9b0"}' \
    "$@"
